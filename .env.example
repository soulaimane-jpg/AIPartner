# ──────────────────────────────────────────────────────────────────────
# Required in production. Validated at boot via `src/env.ts` (Zod).
# ──────────────────────────────────────────────────────────────────────

# Database — Supabase (PostgreSQL)
#
# DATABASE_URL  = pooled connection (PgBouncer, port 6543) used at runtime
# DIRECT_URL    = direct connection (port 5432) used by `prisma migrate` / `db push`
#
# Both strings are copied from Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js v5 — AUTH_SECRET must be ≥ 32 chars (run `openssl rand -base64 32`).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUTH_TRUST_HOST="true"

# Public app URL — used in outbound emails, OG tags, OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────────────
# AI providers — optional. Anthropic preferred (Claude); OpenAI legacy.
# ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""

# ──────────────────────────────────────────────────────────────────────
# Google OAuth — get these from console.cloud.google.com → APIs & Services
# → Credentials → "OAuth 2.0 Client IDs". Add the redirect URI:
#   http://localhost:3000/api/auth/callback/google  (dev)
#   https://<your-domain>/api/auth/callback/google  (prod)
# Auth.js v5 auto-detects the AUTH_GOOGLE_* prefix.
# ──────────────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ──────────────────────────────────────────────────────────────────────
# Google Calendar OAuth (admin meeting scheduling) — separate web client.
# Required scopes: openid, email,
#   https://www.googleapis.com/auth/calendar.events
# Authorised redirect URI:
#   http://localhost:3000/api/admin/google/callback   (dev)
#   https://<your-domain>/api/admin/google/callback   (prod)
# ──────────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# ──────────────────────────────────────────────────────────────────────
# Email provider. Defaults to "mock" (writes Email rows but doesn't send).
# Accepted: mock | smtp | resend | postmark
# ──────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="mock"
EMAIL_FROM="AI Partner <noreply@ai-partner.local>"
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""

# ──────────────────────────────────────────────────────────────────────
# SMTP — used when EMAIL_PROVIDER=smtp. Works with any RFC 5321 server.
#
#   Gmail (with 2FA + app password):
#     SMTP_HOST="smtp.gmail.com"
#     SMTP_PORT="587"
#     SMTP_USER="you@gmail.com"
#     SMTP_PASS="<16-char app password>"
#     SMTP_FROM="AI Partner <you@gmail.com>"
#
#   Mailgun:
#     SMTP_HOST="smtp.mailgun.org"
#     SMTP_PORT="587"
#     SMTP_USER="postmaster@<your-mailgun-domain>"
#     SMTP_PASS="<mailgun smtp password>"
#
#   AWS SES (regional endpoint):
#     SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
#     SMTP_PORT="587"
#     SMTP_USER="<ses smtp user>"
#     SMTP_PASS="<ses smtp pass>"
#
#   SendGrid:
#     SMTP_HOST="smtp.sendgrid.net"
#     SMTP_PORT="587"
#     SMTP_USER="apikey"
#     SMTP_PASS="<sendgrid api key>"
# ──────────────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Leave SMTP_SECURE blank to auto-detect (port 465 → true; else false).
SMTP_SECURE=""
SMTP_FROM=""

# ──────────────────────────────────────────────────────────────────────
# Observability. All optional today; production rollout in Phase 0.
# ──────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
POSTHOG_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ──────────────────────────────────────────────────────────────────────
# Crypto. AUDIT_HMAC_KEY is a separate key used to hash IPs in audit
# logs so raw IPs are never persisted. Generate once and rotate yearly.
# Falls back to AUTH_SECRET in dev.
# ──────────────────────────────────────────────────────────────────────
AUDIT_HMAC_KEY=""

# ──────────────────────────────────────────────────────────────────────
# Rate limit backend. "db" today (uses Postgres). Set to "redis" once
# Upstash creds are filled in.
# ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_BACKEND="db"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
